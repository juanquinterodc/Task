<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/FirstFragment" >
<fragment
    android:id="@+id/FirstFragment"
    android:name="com.dreamcode.task.FirstFragment"
    android:label="@string/first_fragment_label"
    tools:layout="@layout/fragment_first" >

    <action
        android:id="@+id/action_FirstFragment_to_SecondFragment"
        app:destination="@id/SecondFragment" />
    <action
        android:id="@+id/action_FirstFragment_to_ViewNoteFragment"
        app:destination="@id/ViewNoteFragment" />

</fragment>
<fragment
    android:id="@+id/SecondFragment"
    android:name="com.dreamcode.task.SecondFragment"
    android:label="@string/second_fragment_label"
    tools:layout="@layout/fragment_second" >

    <argument
        android:name="noteId"
        android:defaultValue="-1"
        app:argType="integer" />
    <argument
        android:name="noteTitle"
        android:defaultValue="@null"
        app:argType="string"
        app:nullable="true" />
    <argument
        android:name="noteContent"
        android:defaultValue="@null"
        app:argType="string"
        app:nullable="true" />
    <argument
        android:name="noteCategory"
        android:defaultValue="@null"
        app:argType="string"
        app:nullable="true" />
    <argument
        android:name="noteTimestamp"
        android:defaultValue="-1L"
        app:argType="long" />
    <argument
        android:name="noteReminderTime"
        android:defaultValue="-1L"
        app:argType="long" />

    <action
        android:id="@+id/action_SecondFragment_to_FirstFragment"
        app:destination="@id/FirstFragment" />

</fragment>
<fragment
    android:id="@+id/CalendarFragment"
    android:name="com.dreamcode.task.CalendarFragment"
    android:label="Calendar"
    tools:layout="@layout/fragment_calendar" >

    <action
        android:id="@+id/action_CalendarFragment_to_SecondFragment"
        app:destination="@id/SecondFragment" />
    <action
        android:id="@+id/action_CalendarFragment_to_ViewNoteFragment"
        app:destination="@id/ViewNoteFragment" />

</fragment>
<fragment
    android:id="@+id/ViewNoteFragment"
    android:name="com.dreamcode.task.ViewNoteFragment"
    android:label="View Note"
    tools:layout="@layout/fragment_view_note" >

    <argument
        android:name="noteId"
        app:argType="integer" />
    <argument
        android:name="noteTitle"
        app:argType="string" />
    <argument
        android:name="noteContent"
        app:argType="string" />
    <argument
        android:name="noteCategory"
        app:argType="string" />
    <argument
        android:name="noteTimestamp"
        app:argType="long" />
    <argument
        android:name="noteReminderTime"
        app:argType="long" />

    <action
        android:id="@+id/action_ViewNoteFragment_to_SecondFragment"
        app:destination="@id/SecondFragment" />

</fragment>
</navigation>