<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for DreamCode Notes.
   Configures what data is backed up to the cloud and transferred between devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the Room database containing all notes -->
        <include domain="database" path="note_database"/>

        <!-- Include shared preferences containing the Vault PIN and other settings -->
        <include domain="sharedpref" path="DreamCodeNotesPrefs.xml"/>

        <!-- Note: Cache domain is excluded by default in Android Auto Backup.
             Manual exclusion from "root" domain of "cache" causes lint errors if not explicitly included. -->
    </cloud-backup>

    <device-transfer>
        <!-- Same rules apply for direct device-to-device transfer -->
        <include domain="database" path="note_database"/>
        <include domain="sharedpref" path="DreamCodeNotesPrefs.xml"/>
    </device-transfer>
</data-extraction-rules>
